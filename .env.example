KCS_DATABASE_URL=postgresql+psycopg://kcs:CHANGE_ME@127.0.0.1:55488/kcs
KCS_PUBLIC_ORIGIN=http://localhost:8088
KCS_SECURE_COOKIES=false
# Configure existing provider locally. HTTPS origins require secure cookies.
KCS_MODEL_BASE_URL=
# Optional explicit HTTP exception, exact scheme://host:port; empty by default.
KCS_MODEL_HTTP_ALLOWED_ORIGIN=
KCS_MODEL_API_KEY=
KCS_CHAT_MODEL=
KCS_EMBEDDING_BASE_URL=
KCS_EMBEDDING_HTTP_ALLOWED_ORIGIN=
KCS_EMBEDDING_API_KEY=
KCS_EMBEDDING_MODEL=
KCS_ENGINE_URL=
# Only for a trusted private Docker network; exact origin, empty by default.
KCS_ENGINE_HTTP_ALLOWED_ORIGIN=
KCS_ENGINE_API_KEY=
KCS_ENGINE_TIMEOUT_SECONDS=60

# Separate SiliconFlow embedding example:
# KCS_MODEL_BASE_URL=https://api.siliconflow.cn/v1
# KCS_MODEL_API_KEY=sk-...
# KCS_CHAT_MODEL=your-chat-model
# KCS_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# KCS_EMBEDDING_API_KEY=sk-...
# KCS_EMBEDDING_MODEL=BAAI/bge-m3
